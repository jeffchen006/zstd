+/* ZSTD_lazy_mlFloor() :
+ * Returns the mlFloor of a lazy search at ip, when the current solution
+ * has length matchLength and score gain1.
+ * A candidate (ml2, ofb2) replaces the current solution only if
+ * ml2*4 - ZSTD_highbit32(ofb2) > gain1. A searched match has offset >= 1,
+ * so ofb2 >= ZSTD_REP_NUM+1 and ZSTD_highbit32(ofb2) >= 2.
+ * Hence a candidate with ml2 <= (gain1+2)/4 is always rejected,
+ * and the search does not need to measure its length.
+ * The floor is only used when matchLength >= 8 : with a short floor, the first
+ * 4-byte comparison of each candidate becomes hard to predict, and costs more than it saves.
+ * The floor is capped below (iend - ip), so that the search never reads at or beyond iend.
+ * @return : a value within [3, iend-ip-1] */
+MEM_STATIC size_t ZSTD_lazy_mlFloor(size_t matchLength, int gain1, const BYTE* ip, const BYTE* iend)
+{
+    assert(iend - ip > 4-1);
+    if (matchLength < 8) return 4-1;
+    {   size_t const mlFloor = (gain1 + 2 > 4*(4-1)) ? (size_t)(gain1 + 2) / 4 : 4-1;
+        return MIN(mlFloor, (size_t)(iend - ip) - 1);
+    }
+}
